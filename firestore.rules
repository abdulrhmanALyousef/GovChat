rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPrimaryAdmin() {
      return isAuthenticated() && userRole() == 'primary_admin';
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == 'admin';
    }

    function isEmployee() {
      return isAuthenticated() && userRole() == 'employee';
    }

    function isAdminOrAbove() {
      return isAuthenticated() && (userRole() == 'admin' || userRole() == 'primary_admin');
    }

    function adminOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth.uid == uid
                   || isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow write: if request.auth.uid == uid
                    || isPrimaryAdmin()
                    || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow create: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isPrimaryAdmin();

      // Department messages
      match /departments/{deptId}/messages/{msgId} {
        allow read: if isAuthenticated();
        allow write: if isEmployee() || isAdminOrAbove();
      }

      // Org-wide chat
      match /org_chats/{chatId}/messages/{msgId} {
        allow read: if isAuthenticated();
        allow write: if isEmployee() || isAdminOrAbove();
      }

      // Private chats
      match /private_chats/{chatId}/messages/{msgId} {
        allow read, write: if isAuthenticated();
      }

      // E2EE group keys
      match /{conversationPath=**}/groupKey/{uid} {
        allow read: if request.auth.uid == uid || isAdminOrAbove();
        allow write: if isAuthenticated();
      }
    }

    // ── Employees ─────────────────────────────────────────────────────────────
    match /employees/{uid} {
      allow read: if request.auth.uid == uid
                   || isPrimaryAdmin()
                   || (isAdminOrAbove() && resource.data.organizationId == adminOrgId())
                   || isEmployee();
      allow create: if isAuthenticated();
      allow update: if request.auth.uid == uid
                     || isPrimaryAdmin()
                     || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow delete: if isPrimaryAdmin()
                     || (isAdmin() && resource.data.organizationId == adminOrgId());
    }

    // ── Access Requests ───────────────────────────────────────────────────────
    match /accessRequests/{reqId} {
      allow read: if isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow create: if isAuthenticated();
      allow update: if isPrimaryAdmin()
                     || (isAdmin() && resource.data.organizationId == adminOrgId());
    }

    // ── Logs ──────────────────────────────────────────────────────────────────
    match /logs/{logId} {
      allow read: if isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow create: if isAuthenticated();
    }

    // ── Project Groups ────────────────────────────────────────────────────────
    match /projectGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && request.resource.data.organizationId == adminOrgId();
      allow update: if isAdmin() && resource.data.organizationId == adminOrgId();
      allow delete: if (isAdmin() && resource.data.organizationId == adminOrgId())
                     || isPrimaryAdmin();

      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }

      match /groupKey/{uid} {
        allow read: if request.auth.uid == uid || isAdminOrAbove();
        allow write: if isAuthenticated();
      }
    }

    // ── Announcements ─────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      // Primary admin: full access across all orgs
      // Admin: read + write only for their own org
      // Employee: read-only (org isolation enforced client-side via organizationId query filter)
      allow read: if isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId())
                   || isEmployee();
      allow create: if isAdmin()
                     && request.resource.data.organizationId == adminOrgId();
      allow update, delete: if (isAdmin() && resource.data.organizationId == adminOrgId())
                              || isPrimaryAdmin();
    }

    // ── Mail (Cloud Functions trigger) ────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ── Default: deny all ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
