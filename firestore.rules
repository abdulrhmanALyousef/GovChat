rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function employeeDoc() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    function userRole() {
      return userDoc().role;
    }

    function isPrimaryAdmin() {
      return isAuthenticated() && userRole() == 'primary_admin';
    }

    function isAdmin() {
      return isAuthenticated() && userRole() == 'admin';
    }

    function isEmployee() {
      return isAuthenticated() && userRole() == 'employee';
    }

    function isAdminOrAbove() {
      return isAuthenticated() && (userRole() == 'admin' || userRole() == 'primary_admin');
    }

    // Returns the organizationId for admin/primary_admin callers (stored in users/)
    function adminOrgId() {
      return userDoc().organizationId;
    }

    // Returns the organizationId for employee callers (stored in employees/)
    function employeeOrgId() {
      return employeeDoc().organizationId;
    }

    // True when the caller belongs to orgId regardless of role
    function callerBelongsToOrg(orgId) {
      return (isAdminOrAbove() && adminOrgId() == orgId)
          || (isEmployee() && employeeOrgId() == orgId);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth.uid == uid
                   || isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow write: if request.auth.uid == uid
                    || isPrimaryAdmin()
                    || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow create: if isAuthenticated() && request.auth.uid == uid;
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      // Each user may only read their own organization; primary_admin reads all
      allow read: if isPrimaryAdmin() || callerBelongsToOrg(orgId);
      allow create, update, delete: if isPrimaryAdmin();

      // Organization settings — scoped to org members only
      match /settings/{settingDoc} {
        allow read: if isPrimaryAdmin() || callerBelongsToOrg(orgId);
        allow write: if (isAdmin() && adminOrgId() == orgId) || isPrimaryAdmin();
      }

      // Department messages — scoped to org members only
      match /departments/{deptId}/messages/{msgId} {
        allow read: if callerBelongsToOrg(orgId);
        allow write: if (isEmployee() && employeeOrgId() == orgId)
                      || (isAdminOrAbove() && adminOrgId() == orgId);
      }

      // Org-wide chat — scoped to org members only
      match /org_chats/{chatId}/messages/{msgId} {
        allow read: if callerBelongsToOrg(orgId);
        allow write: if (isEmployee() && employeeOrgId() == orgId)
                      || (isAdminOrAbove() && adminOrgId() == orgId);
      }

      // Private chats — scoped to org members only
      match /private_chats/{chatId}/messages/{msgId} {
        allow read, write: if callerBelongsToOrg(orgId);
      }

      // E2EE group keys — only the key owner reads their own key
      match /{conversationPath=**}/groupKey/{uid} {
        allow read: if request.auth.uid == uid || isAdminOrAbove();
        allow write: if isAuthenticated();
      }
    }

    // ── Employees ─────────────────────────────────────────────────────────────
    match /employees/{uid} {
      // Employees may read only members of their own org (needed for E2EE key lookup)
      allow read: if request.auth.uid == uid
                   || isPrimaryAdmin()
                   || (isAdminOrAbove() && resource.data.organizationId == adminOrgId())
                   || (isEmployee() && resource.data.organizationId == employeeOrgId());
      allow create: if isAuthenticated();
      allow update: if request.auth.uid == uid
                     || isPrimaryAdmin()
                     || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow delete: if isPrimaryAdmin()
                     || (isAdmin() && resource.data.organizationId == adminOrgId());
    }

    // ── Access Requests ───────────────────────────────────────────────────────
    match /accessRequests/{reqId} {
      allow read: if isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow create: if isAuthenticated();
      allow update: if isPrimaryAdmin()
                     || (isAdmin() && resource.data.organizationId == adminOrgId());
    }

    // ── Logs ──────────────────────────────────────────────────────────────────
    match /logs/{logId} {
      allow read: if isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId());
      allow create: if isAuthenticated();
    }

    // ── Project Groups ────────────────────────────────────────────────────────
    match /projectGroups/{groupId} {
      // Scoped to org members — employees read groups in their org; admins in their org
      allow read: if isPrimaryAdmin()
                   || (isAdminOrAbove() && resource.data.organizationId == adminOrgId())
                   || (isEmployee() && resource.data.organizationId == employeeOrgId());
      allow create: if isAdmin() && request.resource.data.organizationId == adminOrgId();
      allow update: if isAdmin() && resource.data.organizationId == adminOrgId();
      allow delete: if (isAdmin() && resource.data.organizationId == adminOrgId())
                     || isPrimaryAdmin();

      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }

      match /groupKey/{uid} {
        allow read: if request.auth.uid == uid || isAdminOrAbove();
        allow write: if isAuthenticated();
      }
    }

    // ── Announcements ─────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isPrimaryAdmin()
                   || (isAdmin() && resource.data.organizationId == adminOrgId())
                   || (isEmployee() && resource.data.organizationId == employeeOrgId());
      allow create: if isAdmin()
                     && request.resource.data.organizationId == adminOrgId();
      allow update, delete: if (isAdmin() && resource.data.organizationId == adminOrgId())
                              || isPrimaryAdmin();
    }

    // ── Mail (Cloud Functions trigger) ────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if isPrimaryAdmin();
    }

    // ── Default: deny all ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
